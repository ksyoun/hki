OPENAI_API_KEY=sk-your-key-here
# HTTPS (LAN — Wake Lock / secure context en Chrome)
# 1) python -m hki gen-cert
# 2) HKI_HTTPS=true
HKI_HTTPS=false
# HKI_SSL_CERTFILE=data/certs/hki.crt
# HKI_SSL_KEYFILE=data/certs/hki.key
HKI_HOST=0.0.0.0
HKI_PORT=8765
# HTTP guía audiencia (sin advertencia cert) — solo si HTTPS activo; default PORT+1
# HKI_HTTP_GUIDE_PORT=8766
HKI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# HKI_REALTIME_WS_URL=wss://api.openai.com/v1/realtime?intent=transcription
HKI_FINAL_MODEL=gpt-4o-mini
# Translation context (Contextualizar — referencias + NVI + manuscrito)
HKI_CONTEXT_MODEL=gpt-4o
HKI_BIBLE_API_BASE=https://api.midvash.com/v1
# Spanish NVI on Midvash uses slug nvies (not nvi — Portuguese)
HKI_BIBLE_VERSION=nvies
# VAD (silence before closing an utterance — adds fixed latency)
HKI_VAD_SILENCE_DURATION_MS=500
HKI_VAD_PREFIX_PADDING_MS=300
# Audio capture / level meter (short blocks catch piano & speech transients)
HKI_AUDIO_CHUNK_MS=20
HKI_LEVEL_METER_INTERVAL_MS=50
HKI_LEVEL_PEAK_HOLD_MS=450
# TTS (master switch — /captions speaker ON triggers synthesis)
HKI_TTS_ENABLED=false
HKI_TTS_MODEL=gpt-4o-mini-tts
HKI_TTS_VOICE=onyx
# Unified output: batch recombine → paced caption+TTS release
HKI_OUTPUT_BATCH_SIZE=2
HKI_OUTPUT_TIMEOUT_MS=2500
HKI_OUTPUT_RELEASE_BASE_MS=1500
HKI_OUTPUT_RELEASE_MIN_MS=700
HKI_CAPTION_MAX_LINES=8
# Aliases (same as HKI_OUTPUT_*):
# HKI_TTS_PREP_BATCH_SIZE=2
# HKI_TTS_PREP_TIMEOUT_MS=2500
# HKI_OUTPUT_PREP_MODEL=gpt-4o-mini
# Client playback catch-up when voice backlog grows
HKI_TTS_PLAYBACK_SPEED_THRESHOLD=3
HKI_TTS_PLAYBACK_SPEED_MAX=1.15
# HKI_MIN_AUDIENCE_COUNT=1
# HKI_TTS_INSTRUCTIONS=Lee en voz alta ÚNICAMENTE el texto proporcionado...
# Log translation system prompt on sermon toggle / contextualize
# HKI_TRANSLATION_LOG_PROMPTS=true
# HKI_LOG_LEVEL=DEBUG
